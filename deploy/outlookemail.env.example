# 内置 OutlookEmail 运行时配置模板。
# 复制为同目录 outlookemail.env 后填写真实值；outlookemail.env 已被 gitignore，
# 不要把真实密码或密钥提交进仓库。
# 生成强密钥：python3 -c 'import secrets; print(secrets.token_hex(32))'
FLASK_ENV=production
LOGIN_PASSWORD=change-this-outlookemail-password
SECRET_KEY=change-this-outlookemail-secret-key

# 数据库路径由容器入口固定为 /app/data/outlookemail/outlook_accounts.db；
# 这里保留键名仅用于兼容旧 env，实际值不会覆盖统一数据根目录。
DATABASE_PATH=/app/data/outlookemail/outlook_accounts.db

# 自更新必须关闭：版本由 sub2api-native 的 submodule commit 固定。
# 同时不要挂载 /var/run/docker.sock。
DOCKER_UPDATE_ENABLED=false
