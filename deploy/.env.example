# 仅使用本地镜像；不要填写远程镜像地址。
# HTTP_PROXY/HTTPS_PROXY/NO_PROXY 只传给 deploy/compose.yaml 的本地 BuildKit
# 构建步骤（单一 sub2api-native 镜像）。留空表示直连；代理地址
# 不会写入最终运行镜像或应用配置。
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# 运行时配置。Sub2API Native 与 OutlookEmail 在同一容器中运行；
# 内部邮箱 API 固定为 http://127.0.0.1:5000，不作为外部配置项暴露。
SUB2API_WEB_PORT=8787
SUB2API_WEB_COOKIE_SECURE=0
SUB2API_SHM_SIZE=1gb
XVFB_SCREEN=1920x1080x24
TZ=UTC

# OUTLOOKEMAIL_BIND_HOST：Docker 在宿主机上的监听地址，默认仅回环。
# 局域网管理时改为明确的私网 IP；不要使用 0.0.0.0（那会向所有网卡开放 15000）。
# OUTLOOKEMAIL_PUBLIC_HOST：浏览器实际访问的地址，用于生成“邮箱账户管理”的
# 免密跳转目标，必须是可达的明确 IP/hostname，不允许 0.0.0.0 或 ::。
# 两个变量作用不同：BIND 只决定监听哪张网卡，PUBLIC 只决定跳转目标；
# 反向代理、SSH 隧道或 NAT 场景下两者可以不同。生产建议两者都只用明确私网 IP。
OUTLOOKEMAIL_BIND_HOST=127.0.0.1
OUTLOOKEMAIL_PUBLIC_HOST=127.0.0.1
# 默认 15000：宿主机 5000 可能已被其他服务占用。
OUTLOOKEMAIL_PORT=15000
# 浏览器实际访问端口；未设置时跟随 OUTLOOKEMAIL_PORT。Nginx HTTP 子域名
# 模式通常设为 80（宿主机仍可用 15000 作为上游端口）。需要覆盖时取消注释。
# OUTLOOKEMAIL_PUBLIC_PORT=80

# Gate L 硬门禁：批量 count>1 的浏览器身份隔离完成 Live 验收前仅允许 count=1。
# R2（count=2）验收通过后改为 1000 恢复批量。
SUB2API_GATE_L_MAX_COUNT=1
